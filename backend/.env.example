# Copy to .env (or paste into your host's dashboard). Everything is optional
# for local development — the defaults give you SQLite + in-memory channels.

DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173
# ALLOWED_HOSTS=vibe-api.onrender.com
# CORS_ALLOWED_ORIGINS=https://vibe.vercel.app
# DATABASE_URL=postgresql://user:pass@host/dbname
# REDIS_URL=redis://localhost:6379/0     # only for multi-worker setups

# All of these are genuinely optional — the app works without them.
# YOUTUBE_API_KEY=
# TENOR_API_KEY=

# Email verification: without SMTP the link is printed to the server log and
# returned by the API so the UI can show it.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
